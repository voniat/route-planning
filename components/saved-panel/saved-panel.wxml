<view class="saved-panel" wx:if="{{showSavedPanel}}">
  <view class="saved-mask" bindtap="onClose"></view>
  <view class="saved-panel-body">
    <view class="saved-panel-header">
      <text class="saved-panel-title">已收藏路线</text>
      <text class="saved-panel-close" bindtap="onClose">✕</text>
    </view>
    <view class="saved-empty" wx:if="{{savedRoutes.length === 0}}">
      <text>暂无收藏。规划好路线后点击底部「收藏路线」保存。</text>
    </view>
    <view
      class="saved-item"
      wx:for="{{savedRoutes}}"
      wx:key="id"
    >
      <view class="saved-item-info" bindtap="onLoad" data-id="{{item.id}}">
        <view class="saved-item-name">{{item.name}}</view>
        <view class="saved-item-meta">{{item.city}} · {{item.points.length}}个点 · {{item.savedAt}}</view>
      </view>
      <view class="saved-item-del" catchtap="onDelete" data-id="{{item.id}}">✕</view>
    </view>
  </view>
</view>
