.food-panel {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 400;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  max-height: 65vh; display: flex; flex-direction: column;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.1);
  padding-bottom: env(safe-area-inset-bottom);
}
.food-panel-header {
  display: flex; align-items: baseline; padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0; flex-shrink: 0;
}
.food-panel-title { font-size: 32rpx; font-weight: 700; color: #333; }
.food-panel-hint { font-size: 22rpx; color: #bbb; margin-left: 12rpx; flex: 1; }
.food-panel-close { font-size: 30rpx; color: #bbb; padding: 4rpx 8rpx; }
.food-loading { text-align: center; padding: 60rpx; color: #999; font-size: 28rpx; }
.food-list { flex: 1; overflow-y: auto; padding: 0 12rpx 0 28rpx; }
.food-empty { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }
.food-item {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5;
}
.food-item:last-child { border-bottom: none; }
.food-photo {
  width: 80rpx; height: 80rpx; border-radius: 8rpx; flex-shrink: 0;
  background: #f5f5f5;
}
.food-info { flex: 1; min-width: 0; }
.food-name { font-size: 28rpx; color: #333; font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.food-rating-inline { font-size: 22rpx; color: #f5a623; font-weight: 600; margin-left: 10rpx; letter-spacing: 2rpx; }
.food-addr { font-size: 22rpx; color: #999; margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.food-dist-inline { color: #1989fa; }
.food-add {
  width: 52rpx; height: 52rpx; display: flex; align-items: center;
  justify-content: center; background: #1989fa; color: #fff;
  font-size: 32rpx; border-radius: 50%; flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(25,137,250,0.25);
}
