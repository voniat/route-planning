.routes-page { display: flex; flex-direction: column; height: 100vh; background: #f2f4f8; }

.segment-selector { flex-shrink: 0; }
.segment-scroll { white-space: nowrap; padding: 18rpx 20rpx; background: #fff; }
.segment-tab {
  display: inline-flex; flex-direction: column; align-items: center;
  padding: 18rpx 30rpx; margin-right: 16rpx;
  background: #f2f4f8; border-radius: 16rpx;
  font-size: 24rpx; color: #7a8799;
  border: 1rpx solid transparent;
}
.segment-tab.active { background: linear-gradient(135deg, rgba(30,58,95,0.08), rgba(200,162,74,0.06)); color: #1e3a5f; font-weight: 600; border: 1rpx solid rgba(30,58,95,0.15); }
.seg-from, .seg-to { max-width: 140rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seg-arrow { font-size: 20rpx; margin: 2rpx 0; color: #c8a24a; }

.route-map-wrap { height: 320rpx; flex-shrink: 0; position: relative; }
.route-map-wrap.full { flex: 1; }
.route-map { width: 100%; height: 100%; }
.map-float {
  position: absolute; top: 16rpx; right: 16rpx; z-index: 10;
  background: rgba(255,255,255,0.94); padding: 12rpx 24rpx;
  border-radius: 34rpx; font-size: 24rpx; color: #1e3a5f; font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(30,58,95,0.15);
}

.tab-bar {
  display: flex; background: #fff; border-bottom: 1rpx solid #eef1f5;
}
.tab {
  flex: 1; text-align: center; padding: 26rpx 0;
  font-size: 28rpx; color: #7a8799; position: relative;
}
.tab.active { color: #1e3a5f; font-weight: 700; }
.tab.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%); width: 48rpx; height: 4rpx;
  background: linear-gradient(90deg, #1e3a5f, #c8a24a); border-radius: 2rpx;
}

.route-content { flex: 1; padding: 24rpx 30rpx; }
.scheme-bar {
  display: flex; flex-shrink: 0; padding: 14rpx 20rpx; background: #fff;
  border-top: 1rpx solid #f0f3f7; gap: 12rpx; overflow-x: auto;
}
.scheme-tab {
  display: flex; flex-direction: column; align-items: center;
  padding: 12rpx 24rpx; border-radius: 12rpx;
  background: #f2f4f8; font-size: 22rpx; color: #7a8799;
  white-space: nowrap; flex-shrink: 0;
}
.scheme-tab.active { background: linear-gradient(135deg, rgba(30,58,95,0.1), rgba(200,162,74,0.08)); color: #1e3a5f; font-weight: 700; }
.scheme-label { font-weight: 500; }
.scheme-cost { font-size: 20rpx; color: #c0392b; margin-top: 2rpx; }
.route-header { display: flex; justify-content: space-around; margin-bottom: 28rpx; }
.route-stat { text-align: center; }
.stat-val { font-size: 44rpx; color: #1e3a5f; font-weight: 800; display: block; letter-spacing: 1rpx; }
.stat-label { font-size: 24rpx; color: #9aa7b8; margin-top: 6rpx; }

.route-title { font-size: 30rpx; color: #1e3a5f; font-weight: 700; margin-bottom: 24rpx; letter-spacing: 1rpx; }
.route-icon { margin-right: 8rpx; }

.step-list { padding-left: 20rpx; }
.step-item { display: flex; margin-bottom: 10rpx; }
.step-line { display: flex; flex-direction: column; align-items: center; margin-right: 20rpx; width: 32rpx; flex-shrink: 0; }
.step-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 0 4rpx rgba(30,58,95,0.08); }
.step-line-bar { width: 2rpx; flex: 1; background: #dce3ec; margin: 4rpx 0; }
.step-body {
  flex: 1; background: #fff; border-radius: 16rpx;
  padding: 22rpx 26rpx; margin-bottom: 14rpx;
  box-shadow: 0 4rpx 16rpx rgba(30,58,95,0.06);
}
.step-title { font-size: 28rpx; color: #2c3e50; line-height: 1.6; }
.transit-badge {
  display: inline-block; padding: 2rpx 12rpx; margin-right: 8rpx;
  color: #fff; font-size: 22rpx; border-radius: 6rpx;
  vertical-align: middle;
}
.step-meta { font-size: 24rpx; color: #8a97a8; margin-top: 10rpx; }
.transit-line { margin-top: 14rpx; padding: 14rpx 18rpx; background: linear-gradient(135deg, rgba(30,58,95,0.04), rgba(200,162,74,0.04)); border-radius: 12rpx; }
.line-station { color: #1e3a5f; font-size: 28rpx; font-weight: 700; }
.line-arrow { color: #9aa7b8; font-size: 24rpx; margin: 0 8rpx; }

.taxi-hint {
  margin-top: 14rpx; padding: 16rpx 20rpx;
  background: #fff8ec; border-radius: 12rpx;
  font-size: 24rpx; color: #b8860b; border: 1rpx solid #f0d9a8;
}

.alt-toggle {
  margin-top: 10rpx; padding: 10rpx 16rpx;
  font-size: 24rpx; color: #1e3a5f; background: linear-gradient(135deg, rgba(30,58,95,0.05), rgba(200,162,74,0.05));
  border-radius: 10rpx; text-align: center;
}
.alt-list { margin-top: 10rpx; }
.alt-item { padding: 12rpx 16rpx; background: #f8fafc; border-radius: 10rpx; margin-bottom: 8rpx; }
.alt-name { font-size: 26rpx; color: #2c3e50; font-weight: 600; }
.alt-station { display: block; font-size: 22rpx; color: #8a97a8; margin-top: 4rpx; }

.walk-summary {
  display: flex; flex-direction: column; align-items: center;
  padding: 56rpx 36rpx; background: #fff; border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(30,58,95,0.06);
}
.walk-summary-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.walk-summary-text { font-size: 30rpx; color: #2c3e50; font-weight: 600; text-align: center; }
.walk-summary-hint { font-size: 24rpx; color: #9aa7b8; margin-top: 14rpx; }

.loading-box { flex: 1; display: flex; align-items: center; justify-content: center; }
.loading-text { color: #8a97a8; font-size: 28rpx; letter-spacing: 2rpx; }
.empty-box { flex: 1; display: flex; align-items: center; justify-content: center; color: #9aa7b8; font-size: 28rpx; }
