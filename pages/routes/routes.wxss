.routes-page { display: flex; flex-direction: column; height: 100vh; background: #f5f5f5; }

.segment-scroll { white-space: nowrap; padding: 16rpx 20rpx; background: #fff; }
.segment-tab {
  display: inline-flex; flex-direction: column; align-items: center;
  padding: 16rpx 28rpx; margin-right: 16rpx;
  background: #f0f0f0; border-radius: 12rpx;
  font-size: 24rpx; color: #666;
}
.segment-tab.active { background: #e8f4fd; color: #1989fa; border: 1rpx solid #1989fa; }
.seg-from, .seg-to { max-width: 140rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seg-arrow { font-size: 20rpx; margin: 2rpx 0; }

.route-map-wrap { height: 320rpx; flex-shrink: 0; position: relative; }
.route-map-wrap.full { flex: 1; }
.route-map { width: 100%; height: 100%; }
.map-float {
  position: absolute; top: 16rpx; right: 16rpx; z-index: 10;
  background: rgba(255,255,255,0.92); padding: 10rpx 20rpx;
  border-radius: 30rpx; font-size: 24rpx; color: #1989fa;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.12);
}

.tab-bar {
  display: flex; background: #fff; border-bottom: 1rpx solid #eee;
}
.tab {
  flex: 1; text-align: center; padding: 24rpx 0;
  font-size: 28rpx; color: #666; position: relative;
}
.tab.active { color: #1989fa; font-weight: 600; }
.tab.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%); width: 40rpx; height: 4rpx;
  background: #1989fa; border-radius: 2rpx;
}

.route-content { flex: 1; padding: 20rpx 30rpx; }
.scheme-bar {
  display: flex; flex-shrink: 0; padding: 12rpx 20rpx; background: #fff;
  border-top: 1rpx solid #f0f0f0; gap: 12rpx; overflow-x: auto;
}
.scheme-tab {
  display: flex; flex-direction: column; align-items: center;
  padding: 10rpx 22rpx; border-radius: 8rpx;
  background: #f5f5f5; font-size: 22rpx; color: #666;
  white-space: nowrap; flex-shrink: 0;
}
.scheme-tab.active { background: #e8f4fd; color: #1989fa; }
.scheme-label { font-weight: 500; }
.scheme-cost { font-size: 20rpx; color: #e64340; margin-top: 2rpx; }
.route-header { display: flex; justify-content: space-around; margin-bottom: 24rpx; }
.route-stat { text-align: center; }
.stat-val { font-size: 40rpx; color: #1989fa; font-weight: 700; display: block; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 4rpx; }

.route-title { font-size: 30rpx; color: #333; font-weight: 600; margin-bottom: 20rpx; }
.route-icon { margin-right: 8rpx; }

.step-list { padding-left: 20rpx; }
.step-item { display: flex; margin-bottom: 8rpx; }
.step-line { display: flex; flex-direction: column; align-items: center; margin-right: 20rpx; width: 32rpx; flex-shrink: 0; }
.step-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.step-line-bar { width: 2rpx; flex: 1; background: #e5e5e5; margin: 4rpx 0; }
.step-body {
  flex: 1; background: #fff; border-radius: 12rpx;
  padding: 20rpx 24rpx; margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.step-title { font-size: 28rpx; color: #333; line-height: 1.6; }
.transit-badge {
  display: inline-block; padding: 2rpx 12rpx; margin-right: 8rpx;
  background: #1989fa; color: #fff; font-size: 22rpx; border-radius: 4rpx;
  vertical-align: middle;
}
.step-meta { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.transit-line { margin-top: 12rpx; padding: 12rpx 16rpx; background: #f0f7ff; border-radius: 8rpx; }
.line-name { font-weight: 600; color: #1989fa; margin-right: 8rpx; }
.line-direction { color: #e64340; font-size: 24rpx; display: block; margin-top: 4rpx; }
.line-from { color: #999; font-size: 22rpx; display: block; margin-top: 4rpx; }
.line-station { color: #1989fa; font-size: 28rpx; font-weight: 600; }
.line-arrow { color: #999; font-size: 24rpx; margin: 0 8rpx; }

.taxi-hint {
  margin-top: 12rpx; padding: 14rpx 18rpx;
  background: #fff7e6; border-radius: 10rpx;
  font-size: 24rpx; color: #d48806; border: 1rpx solid #ffd591;
}

.alt-toggle {
  margin-top: 8rpx; padding: 8rpx 14rpx;
  font-size: 24rpx; color: #1989fa; background: #f0f7ff;
  border-radius: 8rpx; text-align: center;
}
.alt-list { margin-top: 8rpx; }
.alt-item { padding: 10rpx 14rpx; background: #fafafa; border-radius: 8rpx; margin-bottom: 6rpx; }
.alt-name { font-size: 26rpx; color: #333; font-weight: 500; }
.alt-station { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }

.walk-summary {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 32rpx; background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.walk-summary-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.walk-summary-text { font-size: 30rpx; color: #333; font-weight: 500; text-align: center; }
.walk-summary-hint { font-size: 24rpx; color: #999; margin-top: 12rpx; }

.loading-box { flex: 1; display: flex; align-items: center; justify-content: center; }
.loading-text { color: #999; font-size: 28rpx; }
.empty-box { flex: 1; display: flex; align-items: center; justify-content: center; color: #999; font-size: 28rpx; }
