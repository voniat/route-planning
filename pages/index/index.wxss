page { height: 100%; background: #edf0f5; }
.map { width: 100%; height: 100%; }

.search-bar {
  position: fixed; top: 20rpx; left: 20rpx; right: 20rpx; z-index: 10;
  background: rgba(255,255,255,0.94); border-radius: 48rpx;
  display: flex; align-items: center; overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1), 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 1rpx solid rgba(255,255,255,0.6);
}
.city-picker {
  flex-shrink: 0; padding: 14rpx 22rpx;
  border-right: 1rpx solid rgba(0,0,0,0.06); background: rgba(25,137,250,0.06);
  display: flex; align-items: center; gap: 6rpx;
}
.city-label {
  font-size: 28rpx; color: #1989fa; font-weight: 700;
  white-space: nowrap; letter-spacing: 1rpx;
}
.city-arrow { font-size: 18rpx; color: #1989fa; opacity: 0.6; }
.search-input-area { flex: 1; display: flex; align-items: center; padding: 12rpx 24rpx; }
.search-icon-text { font-size: 28rpx; margin-right: 10rpx; opacity: 0.5; }
.search-placeholder { color: #aab; font-size: 26rpx; font-weight: 400; }

.route-time-bar {
  margin: 8rpx 0 0; border-radius: 12rpx;
  padding: 14rpx 16rpx; text-align: center;
  background: linear-gradient(135deg, rgba(25,137,250,0.08), rgba(7,193,96,0.06));
  border: 1rpx solid rgba(25,137,250,0.12);
}
.route-time-text { color: #1989fa; font-size: 24rpx; font-weight: 600; }

.point-list {
  position: fixed; left: 20rpx; right: 20rpx;
  max-height: 560rpx; overflow-y: auto;
  background: rgba(255,255,255,0.94); border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1), 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 1rpx solid rgba(255,255,255,0.5);
}
.point-list-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 12rpx; position: sticky; top: 0; z-index: 2;
  padding: 6rpx 8rpx 12rpx;
  border-bottom: 2rpx solid rgba(25,137,250,0.1);
}
.point-list-title { font-size: 28rpx; color: #333; font-weight: 700; letter-spacing: 1rpx; }
.point-list-hint { font-size: 20rpx; color: #bbb; }
.point-list-hint.sorting { color: #e64340; font-weight: 700; }
.optimize-btn { color: #1989fa; font-weight: 600; }

.point-item {
  display: flex; align-items: center; padding: 18rpx 10rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.6); transition: background 0.15s;
}

.point-item:active { background: rgba(25,137,250,0.06); }
.drag-handle {
  width: 28rpx; height: 44rpx; display: flex;
  flex-direction: column; align-items: center; justify-content: center;
  margin-right: 10rpx; flex-shrink: 0; opacity: 0.3;
}
.handle-bars { display: flex; flex-direction: column; gap: 5rpx; }
.bar { width: 20rpx; height: 3rpx; background: #999; border-radius: 2rpx; }

.point-index {
  width: 44rpx; height: 44rpx; border-radius: 14rpx;
  color: #fff; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 16rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #1989fa, #36b1ff);
  box-shadow: 0 2rpx 8rpx rgba(25,137,250,0.25);
}
.point-index.start {
  background: linear-gradient(135deg, #07c160, #2ecc71);
  box-shadow: 0 2rpx 8rpx rgba(7,193,96,0.3);
}
.point-index.end {
  background: linear-gradient(135deg, #e64340, #f56c6c);
  box-shadow: 0 2rpx 8rpx rgba(230,67,64,0.3);
}

.point-name {
  flex: 1; font-size: 28rpx; color: #333; font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.point-time {
  font-size: 20rpx; color: #fff; margin-right: 12rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #1989fa, #36b1ff);
  padding: 4rpx 10rpx; border-radius: 8rpx; font-weight: 600;
}
.point-del {
  width: 48rpx; height: 48rpx; display: flex;
  align-items: center; justify-content: center;
  color: #ccc; font-size: 26rpx; flex-shrink: 0;
  border-radius: 12rpx; transition: all 0.15s;
}
.point-del:active { background: rgba(230,67,64,0.1); color: #e64340; }

.bottom-actions {
  position: fixed; bottom: calc(32rpx + env(safe-area-inset-bottom)); left: 24rpx; right: 24rpx;
  display: flex; gap: 16rpx; flex-wrap: wrap;
  padding: 8rpx 0;
}
.btn {
  flex: 1; text-align: center; padding: 26rpx 20rpx;
  border-radius: 48rpx; font-size: 30rpx; font-weight: 700;
  min-width: 140rpx; letter-spacing: 1rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #1989fa, #0d6efd);
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(25,137,250,0.35), 0 2rpx 4rpx rgba(25,137,250,0.2);
}
.btn-outline {
  background: rgba(255,255,255,0.92);
  color: #1989fa;
  border: 2rpx solid rgba(25,137,250,0.25);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.btn-subtle {
  background: rgba(255,255,255,0.7);
  color: #999;
  border: 2rpx solid rgba(0,0,0,0.06);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  max-width: 160rpx;
}
.btn-start {
  background: linear-gradient(135deg, #07c160, #2ecc71);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.35);
}
.hint {
  text-align: center; color: #999; font-size: 28rpx;
  background: rgba(255,255,255,0.9); padding: 20rpx 32rpx;
  border-radius: 44rpx; flex: 1; font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.toolbar-row {
  position: fixed; top: 112rpx; left: 20rpx; right: 20rpx; z-index: 10;
  display: flex; gap: 12rpx; flex-wrap: wrap;
}
.toolbar-btn {
  flex: 1 1 280rpx; padding: 12rpx 16rpx; border-radius: 32rpx; font-size: 22rpx;
  background: rgba(255,255,255,0.92); color: #1989fa;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  font-weight: 600; letter-spacing: 1rpx; text-align: center;
  border: 1rpx solid rgba(25,137,250,0.15);
}

.city-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  visibility: hidden; opacity: 0; transition: all 0.25s;
}
.city-modal.show { visibility: visible; opacity: 1; }
.city-backdrop { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); }
.city-panel {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 32rpx 32rpx 0 0; overflow: hidden;
}
.city-panel-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx; border-bottom: 1rpx solid #f0f0f0;
}
.city-panel-cancel { font-size: 30rpx; color: #999; }
.city-panel-title { font-size: 32rpx; font-weight: 700; color: #333; }
.city-panel-confirm { font-size: 30rpx; color: #1989fa; font-weight: 700; }
.city-picker-view { width: 100%; height: 400rpx; }
.city-picker-indicator { height: 80rpx; }
.city-picker-item {
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; color: #333; height: 80rpx;
}

.point-item.sorting-item {
  background: rgba(25,137,250,0.08);
  border: 2rpx dashed rgba(25,137,250,0.4);
  box-shadow: 0 4rpx 16rpx rgba(25,137,250,0.12);
}

.sort-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 99; background: transparent;
}
.sort-ghost {
  position: fixed; left: 20rpx; right: 20rpx;
  background: #fff; box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.18);
  border-radius: 16rpx; z-index: 999;
  display: flex; align-items: center; padding: 18rpx 12rpx;
}

.time-add-row { background: rgba(25,137,250,0.03); }
.time-add-row .point-name { color: #1989fa; font-weight: 600; }

.time-panel {
  border-top: 2rpx dashed rgba(25,137,250,0.15);
  padding: 16rpx 6rpx 10rpx; margin-top: 6rpx;
}
.time-panel-header {
  font-size: 22rpx; color: #999; margin-bottom: 12rpx;
  text-align: center; font-weight: 500;
}
.time-row {
  display: flex; align-items: center; padding: 14rpx 10rpx;
  margin: 3rpx 0; border-radius: 12rpx; position: relative;
  background: rgba(255,255,255,0.5);
}
.time-slot-picker { flex-shrink: 0; }
.time-slot-val {
  font-size: 32rpx; font-weight: 700; color: #1989fa;
  padding: 8rpx 16rpx; border-radius: 10rpx;
  background: linear-gradient(135deg, rgba(25,137,250,0.1), rgba(25,137,250,0.04));
  min-width: 120rpx; text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(25,137,250,0.1);
}
.time-slot-val.empty { color: #bbb; background: #f5f5f5; box-shadow: none; }
.time-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #1989fa; margin: 0 16rpx; flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(25,137,250,0.12);
}
.time-info { flex: 1; min-width: 0; }
.time-info-name {
  font-size: 26rpx; color: #333; font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.time-info-tag { font-size: 18rpx; color: #aaa; margin-top: 2rpx; }
.time-auto-row { text-align: center; padding: 14rpx 0 6rpx; }
.time-auto-btn {
  font-size: 22rpx; color: #1989fa; font-weight: 600;
  padding: 8rpx 24rpx; border-radius: 20rpx;
  background: rgba(25,137,250,0.06);
}

.time-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 300;
}
.time-modal-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); }
.time-modal-panel {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 32rpx 32rpx 0 0; overflow: hidden;
}
.time-modal-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx; border-bottom: 1rpx solid #f0f0f0;
}
.time-modal-cancel { font-size: 30rpx; color: #999; }
.time-modal-title { font-size: 32rpx; font-weight: 700; color: #333; }
.time-modal-confirm { font-size: 30rpx; color: #1989fa; font-weight: 700; }
.time-picker-view { width: 100%; height: 360rpx; }
.time-pick-indicator { height: 80rpx; }
.time-pick-item {
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; color: #333; height: 80rpx;
}

.share-canvas {
  position: fixed; left: -9999px; top: 0;
  width: 375px;
}

.trip-panel {
  position: fixed; left: 24rpx; right: 24rpx; bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.97); border-radius: 24rpx;
  padding: 28rpx 32rpx; z-index: 30;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.18);
}
.trip-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16rpx;
}
.trip-progress { font-size: 24rpx; color: #1989fa; font-weight: 700; letter-spacing: 1rpx; }
.trip-exit { font-size: 24rpx; color: #999; padding: 4rpx 8rpx; }
.trip-current { margin-bottom: 10rpx; }
.trip-label { display: block; font-size: 22rpx; color: #999; margin-bottom: 4rpx; }
.trip-name {
  font-size: 32rpx; color: #07c160; font-weight: 700;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;
}
.trip-name.next { color: #1989fa; }
.trip-arrow { text-align: center; font-size: 24rpx; color: #999; margin: 8rpx 0; }
.trip-next { margin-bottom: 20rpx; }
.trip-info { display: block; font-size: 24rpx; color: #666; margin-top: 6rpx; }
.trip-btn {
  background: linear-gradient(135deg, #07c160, #2ecc71);
  color: #fff; text-align: center; padding: 26rpx;
  border-radius: 48rpx; font-size: 30rpx; font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.35);
}
