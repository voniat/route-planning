/* pages/agent/agent.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6fa;
  overflow: hidden;
}

.chat-list {
  flex: 1;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.msg.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

.avatar.assistant { background: linear-gradient(135deg, #f78da7, #e040fb); }
.avatar.user { background: linear-gradient(135deg, #43e97b, #38f9d7); color: #333; }

.bubble-wrap {
  max-width: 480rpx;
}

.bubble {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble.assistant {
  background: #fff;
  color: #333;
  margin-left: 16rpx;
  border-top-left-radius: 4rpx;
}

.bubble.user {
  background: #07c160;
  color: #fff;
  margin-right: 16rpx;
  border-top-right-radius: 4rpx;
}

.loading-text { color: #999; }

/* 动作标签 */
.action-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-left: 16rpx;
  margin-top: 8rpx;
}

.msg.user .action-tags {
  margin-left: 0;
  margin-right: 16rpx;
  justify-content: flex-end;
}

.action-tag {
  background: #e8f4fd;
  color: #1989fa;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 快捷操作 */
.quick-bar {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  flex-shrink: 0;
  background: #f5f6fa;
}

.quick-bar::-webkit-scrollbar { height: 0; }

.quick-chip {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  background: #fff;
  border: 1rpx solid #e0e4ea;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #555;
  font-weight: 500;
}

.quick-chip:active {
  background: #e8f4fd;
  color: #1989fa;
  border-color: #1989fa;
}

/* 底部固定栏 */
.bottom-bar {
  flex-shrink: 0;
  border-top: 1rpx solid #eee;
  background: #fff;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: #07c160;
  color: #fff;
  border-radius: 34rpx;
  font-size: 26rpx;
}

.send-btn[disabled] {
  background: #ccc;
}
