<!-- pages/agent/agent.wxml -->
<view class="container">
  <scroll-view class="chat-list" scroll-y scroll-into-view="msg-{{messages.length - 1}}">
    <block wx:for="{{messages}}" wx:key="index">
      <view class="msg {{item.role}}" id="msg-{{index}}">
        <view class="avatar {{item.role}}">
          {{item.role === 'user' ? '我' : 'T'}}
        </view>
        <view class="bubble-wrap">
          <view class="bubble {{item.role}}">
            <text wx:if="{{item.loading}}" class="loading-text">{{item.content}}</text>
            <block wx:else>
              <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this">{{line}}</view>
            </block>
          </view>
          <block wx:if="{{item.actionTags && item.actionTags.length > 0}}">
            <view class="action-tags">
              <view class="action-tag" wx:for="{{item.actionTags}}" wx:key="*this">{{item}}</view>
            </view>
          </block>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="bottom-bar">
    <view class="quick-bar" wx:if="{{!sending}}">
      <view class="quick-chip" bindtap="quickSend" data-text="帮我优化路线顺序">优化路线</view>
      <view class="quick-chip" bindtap="quickSend" data-text="附近有什么好吃的">附近美食</view>
      <view class="quick-chip" bindtap="quickSend" data-text="查看公交路线">查看路线</view>
      <view class="quick-chip" bindtap="quickSend" data-text="清空所有途经点">清空</view>
    </view>
    <view class="input-bar">
      <input
        class="chat-input"
        value="{{input}}"
        placeholder="问路线、查天气、搜美食..."
        bindinput="onInput"
        bindconfirm="send"
        confirm-type="send"
        disabled="{{sending}}"
      />
      <button class="send-btn" size="mini" bindtap="send" disabled="{{sending || !input}}">发送</button>
    </view>
  </view>
</view>
