.search-page { min-height: 100vh; background: #f2f4f8; padding-bottom: 40rpx; }

.search-header {
  background: #fff; padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eef1f5;
}
.search-input-wrap {
  background: #f2f4f8; border-radius: 44rpx; padding: 8rpx 30rpx;
  display: flex; align-items: center;
  border: 1rpx solid rgba(30,58,95,0.06);
}
.search-input { height: 76rpx; font-size: 30rpx; flex: 1; }
.search-btn {
  font-size: 36rpx; padding: 10rpx 0 10rpx 20rpx;
  flex-shrink: 0;
}

.back-bar {
  display: flex; align-items: center; justify-content: center;
  padding: 22rpx; margin: 20rpx 30rpx 0;
  background: linear-gradient(135deg, rgba(30,58,95,0.06), rgba(200,162,74,0.06));
  border-radius: 18rpx; gap: 12rpx;
  border: 1rpx solid rgba(30,58,95,0.08);
}
.back-icon { font-size: 32rpx; }
.back-text { font-size: 28rpx; color: #1e3a5f; font-weight: 500; }

.result-list { padding: 0 30rpx; }
.result-item {
  display: flex; align-items: center; padding: 26rpx 22rpx;
  margin-bottom: 18rpx; background: #fff; border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(30,58,95,0.06);
}
.result-icon { font-size: 38rpx; margin-right: 22rpx; flex-shrink: 0; }
.result-info { flex: 1; min-width: 0; }
.result-title { font-size: 30rpx; color: #2c3e50; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 8rpx; }
.added-tag { color: #c8a24a; font-size: 22rpx; font-weight: 600; margin-left: 8rpx; }
.result-addr { font-size: 24rpx; color: #8a97a8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dist-tag {
  display: inline-block; margin-left: 12rpx; padding: 2rpx 12rpx;
  background: linear-gradient(135deg, rgba(30,58,95,0.08), rgba(200,162,74,0.08));
  color: #1e3a5f; font-size: 20rpx; border-radius: 8rpx;
  vertical-align: middle;
}
.result-action { margin-left: 16rpx; flex-shrink: 0; }
.action-add {
  width: 52rpx; height: 52rpx; display: flex; align-items: center;
  justify-content: center; background: linear-gradient(135deg, #1e3a5f, #2c5f8a); color: #fff; font-size: 38rpx;
  border-radius: 50%; line-height: 1;
  box-shadow: 0 4rpx 12rpx rgba(30,58,95,0.3);
}
.action-added { color: #c8a24a; font-size: 26rpx; font-weight: 600; }
.empty { text-align: center; padding: 88rpx 0; color: #9aa7b8; font-size: 28rpx; }
.suggestion-list { margin: 20rpx 30rpx; background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: 0 6rpx 20rpx rgba(30,58,95,0.08); }
.suggestion-item { display: flex; align-items: center; padding: 22rpx 26rpx; border-bottom: 1rpx solid #f0f3f7; }
.suggestion-item:last-child { border-bottom: none; }
.suggestion-icon { font-size: 28rpx; margin-right: 20rpx; opacity: 0.4; }
.suggestion-info { flex: 1; min-width: 0; }
.suggestion-name { font-size: 28rpx; color: #2c3e50; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.suggestion-dist { font-size: 22rpx; color: #9aa7b8; margin-top: 4rpx; }

.history-list { margin: 20rpx 30rpx 0; background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(30,58,95,0.06); }
.history-header { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 26rpx 14rpx; }
.history-title { font-size: 26rpx; font-weight: 700; color: #1e3a5f; letter-spacing: 2rpx; }
.history-clear { font-size: 24rpx; color: #c0392b; }
.history-item { display: flex; align-items: center; padding: 18rpx 26rpx; border-top: 1rpx solid #f5f7fa; }
.history-icon { font-size: 24rpx; margin-right: 18rpx; opacity: 0.5; }
.history-text { font-size: 28rpx; color: #2c3e50; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
