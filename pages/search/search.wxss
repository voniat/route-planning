.search-page { min-height: 100vh; background: #f5f5f5; padding-bottom: 40rpx; }

.search-header {
  background: #fff; padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}
.search-input-wrap {
  background: #f5f5f5; border-radius: 40rpx; padding: 6rpx 30rpx;
  display: flex; align-items: center;
}
.search-input { height: 72rpx; font-size: 30rpx; flex: 1; }
.search-clear {
  width: 40rpx; height: 40rpx; display: flex; align-items: center;
  justify-content: center; font-size: 22rpx; color: #bbb;
  background: rgba(0,0,0,0.1); border-radius: 50%;
  margin-right: 8rpx; flex-shrink: 0;
}
.search-btn {
  font-size: 36rpx; padding: 10rpx 0 10rpx 20rpx;
  flex-shrink: 0;
}

.back-bar {
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx; margin: 16rpx 30rpx 0;
  background: #e8f4fd; border-radius: 14rpx; gap: 10rpx;
}
.back-icon { font-size: 32rpx; }
.back-text { font-size: 28rpx; color: #333; }

.result-list { padding: 0 30rpx; }
.result-item {
  display: flex; align-items: center; padding: 24rpx 20rpx;
  margin-bottom: 16rpx; background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.result-icon { font-size: 36rpx; margin-right: 20rpx; flex-shrink: 0; }
.result-photo {
  width: 88rpx; height: 88rpx; border-radius: 12rpx;
  background: #f0f0f0; display: block;
}
.result-info { flex: 1; min-width: 0; }
.result-title { font-size: 30rpx; color: #333; font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 6rpx; }
.added-tag { color: #07c160; font-size: 22rpx; font-weight: 500; }
.result-addr { font-size: 24rpx; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dist-tag {
  display: inline-block; margin-left: 12rpx; padding: 2rpx 10rpx;
  background: #e8f8e8; color: #07c160; font-size: 20rpx; border-radius: 6rpx;
  vertical-align: middle;
}
.area-tag {
  display: inline-block; margin-left: 12rpx; padding: 2rpx 10rpx;
  background: #e8f4fd; color: #1989fa; font-size: 20rpx; border-radius: 6rpx;
  vertical-align: middle;
}
.result-action { margin-left: 16rpx; flex-shrink: 0; }
.action-add {
  width: 48rpx; height: 48rpx; display: flex; align-items: center;
  justify-content: center; background: #1989fa; color: #fff; font-size: 36rpx;
  border-radius: 50%; line-height: 1;
}
.empty { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }
.suggestion-list { margin: 0 30rpx; background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }
.suggestion-item { display: flex; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.suggestion-item:last-child { border-bottom: none; }
.suggestion-icon { font-size: 28rpx; margin-right: 18rpx; opacity: 0.4; }
.suggestion-info { flex: 1; min-width: 0; }
.suggestion-name { font-size: 28rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.suggestion-dist { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.history-list { margin: 20rpx 30rpx 0; background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.history-header { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 24rpx 12rpx; }
.history-title { font-size: 26rpx; font-weight: 600; color: #666; }
.history-clear { font-size: 24rpx; color: #e64340; }
.history-item { display: flex; align-items: center; padding: 16rpx 24rpx; border-top: 1rpx solid #f5f5f5; }
.history-del { font-size: 24rpx; color: #ccc; padding: 8rpx 12rpx; flex-shrink: 0; }
.history-icon { font-size: 24rpx; margin-right: 16rpx; opacity: 0.5; }
.history-text { font-size: 28rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
