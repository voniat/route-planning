<view class="search-page">
  <view class="search-header">
    <view class="search-input-wrap">
      <input
        class="search-input"
        placeholder="搜索城市或地点名称"
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="doSearch"
        bindblur="hideSuggestions"
      />
      <view class="search-clear" wx:if="{{keyword}}" catchtap="clearKeyword">✕</view>
      <view class="search-btn" bindtap="doSearch">🔍</view>
    </view>
  </view>

  <view class="back-bar" bindtap="chooseLocation">
    <text class="back-icon">🗺</text>
    <text class="back-text">返回地图选点</text>
  </view>

  <view class="history-list" wx:if="{{history.length > 0 && !searched && !keyword}}">
    <view class="history-header">
      <text class="history-title">搜索记录</text>
      <text class="history-clear" bindtap="clearHistory">清空</text>
    </view>
    <view
      class="history-item"
      wx:for="{{history}}"
      wx:key="*this"
      bindtap="tapHistory"
      data-kw="{{item}}"
    >
      <text class="history-icon">🕐</text>
      <text class="history-text">{{item}}</text>
      <text class="history-del" catchtap="deleteHistoryItem" data-index="{{index}}">✕</text>
    </view>
  </view>

  <view class="suggestion-list" wx:if="{{showSuggestions && suggestions.length > 0}}">
    <view
      class="suggestion-item"
      wx:for="{{suggestions}}"
      wx:key="_key"
      bindtap="selectSuggestion"
      data-name="{{item.name}}"
    >
      <text class="suggestion-icon">🔍</text>
      <view class="suggestion-info">
        <view class="suggestion-name">{{item.name}}</view>
        <view class="suggestion-dist">{{item.district}}</view>
      </view>
    </view>
  </view>

  <view class="result-list" wx:if="{{results.length > 0}}">
    <view
      class="result-item"
      wx:for="{{results}}"
      wx:key="id"
      bindtap="selectResult"
      data-id="{{item.id}}"
    >
      <view class="result-icon">
        <image
          wx:if="{{item.photo}}"
          class="result-photo"
          src="{{item.photo}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          binderror="onPhotoError"
          data-index="{{index}}"
          catchtap="previewPhoto"
          data-url="{{item.photo}}"
        ></image>
        <text wx:elif="{{item.added}}">✅</text>
        <text wx:else>📍</text>
      </view>
      <view class="result-info">
        <view class="result-title">{{item.title}}<text wx:if="{{item.added}}" class="added-tag">（已添加）</text></view>
        <view class="result-addr">{{item.address}}<text wx:if="{{item._distStr}}" class="dist-tag">{{item._distStr}}</text><text wx:if="{{item.bounds}}" class="area-tag">区域范围</text></view>
      </view>
      <view class="result-action">
        <text class="action-add">+</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{results.length === 0 && searched}}">
    <text>未找到相关地点</text>
  </view>
</view>
